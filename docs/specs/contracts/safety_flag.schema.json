{
  "$defs": {
    "RiskLevel": {
      "description": "Clinical risk, used both for routing decisions and safety gating.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One policy or risk finding raised against a candidate answer.",
  "properties": {
    "claim_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Id"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    }
  },
  "required": [
    "code"
  ],
  "title": "SafetyFlag",
  "type": "object"
}
