      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "latency_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "ok": {
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "result": {
      "default": null,
      "title": "Result"
    },
    "timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
