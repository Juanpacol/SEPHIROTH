# Environment: development | test | staging | production
# In staging/production, JWT_SECRET must not be a known insecure default and
# must be >=32 chars (enforced by Settings at startup — see core/config.py).
ENVIRONMENT=development

# Database (async driver). Always the LOCAL docker-compose Postgres here, host
# port 5433. This file never holds a production connection: the app refuses to
# start against a remote host in development/test (ALLOW_REMOTE_DB), and
# docker compose ignores this variable on purpose. To look at production use
# scripts/inspect_db.py with a read-only role; see
# docs/05-operations/database-environments.md (that doc also covers running
# against a managed Postgres such as Supabase, and the session-pooler note).
DATABASE_URL=postgresql+asyncpg://clinical_ai:clinical_ai_password@localhost:5433/clinical_ai_db

# Optional: run `migrations/roles.sql` once, then point DATABASE_URL above
# at the resulting `clinical_ai_app` (no-DDL, least-privilege) role and set
# this to the schema-owning role's connection string so migrations still
# have somewhere to run DDL from. Unset = migrations run as DATABASE_URL's
# role, same as before this existed. See docs/04-development/setup.md's
# "Database roles" section.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://clinical_ai:clinical_ai_password@localhost:5433/clinical_ai_db

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=1440

# LLM provider. "gemini" (default, below) sends chat+vision to the cloud —
# PHI leaves the machine once GEMINI_API_KEY is set, see README's privacy
# notice. "ollama" keeps everything local (no key, no quota) — see the
# "Local LLM (Ollama)" block further down and comment GEMINI_API_KEY out
# instead of deleting it, so switching back to "gemini" is a one-line edit.
LLM_PROVIDER=gemini

# LLM — Google Gemini API (AI Studio free tier). Get a key at
# https://aistudio.google.com/apikey. PHI leaves the machine once this is
# set — see README's privacy notice before using real patient data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_VISION_MODEL=gemini-flash-latest

# Fallback LLM — Groq (free tier, OpenAI-compatible API). Used only for
# text/tool-calling when Gemini's rate limit or DAILY request quota is
# exhausted (a real, observed free-tier constraint — see README §
# Evaluation). No fallback for embeddings. Get a free key at
# https://console.groq.com/keys. Leave unset to disable fallback entirely.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Vision fallback is opt-in and OFF by default — Groq's vision model
# lineup has churned (Llama 4 Scout/Maverick both deprecated in favor of
# text-only replacements). Set this to a vision-capable Groq model id to
# accept that instability in exchange for imaging staying up when
# Gemini's vision quota is exhausted, instead of degrading to "unavailable."
# GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Local LLM — Ollama (chat + vision, no key, no quota, no PHI leaving the
# machine). Only used when LLM_PROVIDER=ollama above. Chat and vision are
# two separate pulled models — run `ollama pull <model>` for each one you
# set here, and `ollama serve` (or scripts/start_ollama.sh, which also
# warms both models so the first request isn't a slow cold-load) before
# starting the API, or `/api/agents/*` returns a 503 "Ollama is not
# reachable" error. `scripts/start_ollama.sh` reads these same
# OLLAMA_MODEL/OLLAMA_VISION_MODEL variables from THIS shell's environment,
# not from this file directly — export them first (or run it through
# `set -a; source .env; set +a; scripts/start_ollama.sh`), otherwise it
# warms its own hardcoded defaults instead of the model the app is
# actually configured to call.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
LLM_ENABLE_FALLBACK=true

# RAG — dense retrieval fused with keyword scoring; Recall@1 on paraphrases
# is calibrated against gemini-embedding-001. Falls back to keyword-only
# automatically if GEMINI_API_KEY is unset or the committed artifact is
# missing — see README § Evaluation.
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RETRIEVAL_MIN_SIMILARITY=0.70
RETRIEVAL_MODE=hybrid
ENABLE_RAG_EMBEDDINGS=true

# Medical AI model weights (optional — features degrade gracefully without them)
# MEDCAT_MODEL_PATH=./models/medcat_model_pack.zip
# MONAI_MODEL_PATH=./models/monai_densenet121.pt

# Features
DEBUG=false
ENABLE_IMAGE_ANALYSIS=true
ENABLE_VISION_ANALYSIS=true
ENABLE_RAG=true
ENABLE_AGENTS=true
