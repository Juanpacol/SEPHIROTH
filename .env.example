# Environment: development | test | staging | production
# In staging/production, JWT_SECRET must not be a known insecure default and
# must be >=32 chars (enforced by Settings at startup — see core/config.py).
ENVIRONMENT=development

# Database (async driver). Two supported setups:
#   - Local (default below): docker-compose Postgres, host port 5433.
#   - Supabase (managed Postgres in the cloud): use the "Session pooler"
#     connection string from Project Settings -> Database -> Connection
#     string (port 5432, NOT the 6543 transaction pooler — that one needs
#     asyncpg prepared statements disabled). Requires the DB password from
#     that same page (reset it there if you don't have it). pgvector is
#     enabled automatically by init_db() on first boot either way.
#     DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://clinical_ai:clinical_ai_password@localhost:5433/clinical_ai_db

# Optional: run `migrations/roles.sql` once, then point DATABASE_URL above
# at the resulting `clinical_ai_app` (no-DDL, least-privilege) role and set
# this to the schema-owning role's connection string so migrations still
# have somewhere to run DDL from. Unset = migrations run as DATABASE_URL's
# role, same as before this existed. See docs/04-development/setup.md's
# "Database roles" section.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://clinical_ai:clinical_ai_password@localhost:5433/clinical_ai_db

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=1440

# LLM provider. Default is `ollama` — local, free, and nothing leaves the
# machine. A fresh install needs no key at all:
#
#   ollama serve && ollama pull qwen2.5:14b
#
# See docs/05-operations/on-premise-runbook.md for the model-size table and
# the clinic deployment.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
# A local model is slower than a hosted one; raise this if consultations
# time out on CPU inference.
# OLLAMA_TIMEOUT_SECONDS=300

# May patient content reach a provider outside this deployment?
#
# Off by default, and inert while the provider is local — nothing leaves, so
# there is nothing to gate. Setting LLM_PROVIDER to a remote provider without
# also setting this degrades the PHI-carrying features rather than leaking:
# consultations refuse, drafts keep their template, timelines fall back to the
# deterministic lexicon. See docs/08-decisions/ADR-015-phi-egress-enumerated-seams.md.
AI_ALLOW_PHI=false

# LLM — Google Gemini API (AI Studio free tier). Get a key at
# https://aistudio.google.com/apikey. Requires LLM_PROVIDER=gemini as of
# SPEC-022: setting a key alone no longer selects it, because a default that
# quietly ships clinical text to a third party is the wrong default. PHI
# leaves the machine only with LLM_PROVIDER=gemini *and* AI_ALLOW_PHI=true —
# see README's privacy notice before using real patient data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_VISION_MODEL=gemini-flash-latest

# Fallback LLM — Groq (free tier, OpenAI-compatible API). Used only for
# text/tool-calling when Gemini's rate limit or DAILY request quota is
# exhausted (a real, observed free-tier constraint — see README §
# Evaluation). No fallback for embeddings. Get a free key at
# https://console.groq.com/keys. Leave unset to disable fallback entirely.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Vision fallback is opt-in and OFF by default — Groq's vision model
# lineup has churned (Llama 4 Scout/Maverick both deprecated in favor of
# text-only replacements). Set this to a vision-capable Groq model id to
# accept that instability in exchange for imaging staying up when
# Gemini's vision quota is exhausted, instead of degrading to "unavailable."
# GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
LLM_ENABLE_FALLBACK=true

# RAG — dense retrieval fused with keyword scoring; Recall@1 on paraphrases
# is calibrated against gemini-embedding-001. Falls back to keyword-only
# automatically if GEMINI_API_KEY is unset or the committed artifact is
# missing — see README § Evaluation.
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RETRIEVAL_MIN_SIMILARITY=0.70
RETRIEVAL_MODE=hybrid
ENABLE_RAG_EMBEDDINGS=true

# Medical AI model weights (optional — features degrade gracefully without them)
# MEDCAT_MODEL_PATH=./models/medcat_model_pack.zip
# MONAI_MODEL_PATH=./models/monai_densenet121.pt

# Features
DEBUG=false
ENABLE_IMAGE_ANALYSIS=true
ENABLE_VISION_ANALYSIS=true
ENABLE_RAG=true
ENABLE_AGENTS=true

# Web push (SPEC-025). Both empty disables push entirely and every notification
# path behaves exactly as it did before -- the in-app bell is unchanged.
# Generate a pair with `.venv/bin/python scripts/generate_vapid_keys.py`.
# The private key is a secret: it authorises sending push as this application.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@sephiroth.local

# Push payloads NEVER contain patient content -- the copy is a fixed table
# keyed on notification type, not the notification's own message. See
# docs/08-decisions/ADR-018-push-payloads-carry-no-phi.md.
