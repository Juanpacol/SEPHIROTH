# LLM profile: cloud (AB#67/AB#70). Chat + vision go to Google Gemini — PHI
# leaves the machine once GEMINI_API_KEY is set, see README's privacy notice.
#
# Non-secret provider/model/timeout defaults only — GEMINI_API_KEY itself
# stays in `.env`, which `scripts/dev.sh up cloud` loads on top of this file.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
LLM_ENABLE_FALLBACK=true
